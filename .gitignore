# Godot 4+ specific ignores
.godot/
/android/
/build/

# Local dev-only files (never part of the build)
/.mcp.json
/blender/

# Game assets live on Cloudflare R2 (see assets_manifest.json for the pack
# URL and scripts/tools/fetch_assets_dev.sh to populate locally). Kenney CC0
# packs are vendored in-tree as exceptions so contributors don't need to
# fetch them — see README credits.
/assets/*
!/assets/kenney_input-prompts/
!/assets/kenney_nature-pack/
# Small UI sprites (menu panels, icons) committed directly — too small to be
# worth the R2 round-trip and painful to iterate on through the asset pack.
!/assets/ui/
# Original assets we author in-house (e.g. Blender-built room geometry) are
# committed directly so contributors don't need the pack to load these scenes.
# Each parent dir must be re-included before the leaf negation works.
!/assets/stages/
/assets/stages/*
!/assets/stages/city_e/
/assets/stages/city_e/*
!/assets/stages/city_e/s00e_office/
/assets/stages/city_e/s00e_office/*
!/assets/stages/city_e/s00e_office/lndmd/
# Floor meshes are authored in-house (Blender export) for collision tweaks.
# Whitelist *-floor.glb under every stage so they can ship with the binary
# instead of going through the Arweave asset-pack roundtrip. The .glb.import
# companion ships alongside so Godot doesn't re-import on first launch. The
# texture/etc. content inside lndmd stays excluded — only floor meshes.
!/assets/stages/*/
!/assets/stages/*/*/
!/assets/stages/*/*/lndmd/
/assets/stages/*/*/lndmd/*
!/assets/stages/*/*/lndmd/*-floor.glb
!/assets/stages/*/*/lndmd/*-floor.glb.import
# Market dir is mostly pack-only PSO textures, but our authored assets are in-house.
!/assets/stages/city_e/market/
/assets/stages/city_e/market/*
!/assets/stages/city_e/market/canyon_panorama*
!/assets/stages/city_e/market/wall_extension*
# Edited copy of s00e_sa1_m.glb with the original PSO shop carts removed
# (generated by /market-editor, hide-and-export workflow).
!/assets/stages/city_e/market/s00e_sa1_m_no_cart*
# In-house replacements for the pack-shipped shop carts.
!/assets/stages/city_e/market/weapon_shop/
!/assets/stages/city_e/market/weapon_shop/*
!/assets/stages/city_e/market/item_shop/
!/assets/stages/city_e/market/item_shop/*
# In-house NPCs converted from third-party assets (VRMs, etc.) live alongside
# the pack-shipped np_*** characters; whitelist them per-folder.
!/assets/npcs/
/assets/npcs/*
!/assets/npcs/item_shop/
!/assets/npcs/item_shop/*
# Playwright-mcp scratch directory — populated by browser_take_screenshot
# and browser_snapshot calls during debug sessions. Not project content.
.playwright-mcp/
# Aborted browser-download fragments (occasionally land at the project
# root from xdg-portal flows). Always safe to ignore + delete.
.xdp-Unconfirmed*
# Raw PSOBB SFX pool used by the web labeler; also on R2.
/web/public/assets/psobb_sfx/

# Web app
web/node_modules/
web/dist/
# Dev-only symlinks to psz-sketch (absolute, not portable)
web/public/weapons
web/public/player
web/public/enemies

# Python cache
__pycache__/

# Root-level scratch/dev files (not part of project)
/Gemini_Generated_Image_*
/Humar_body*
/Saber.glb
/Saber_*.png
/Saber_*.png.import
/Saber.glb.import
/Moonlight-*.AppImage
/Phantasy Star Onine_*
/discord_kit_*.txt

# Asset pack build output (assets_manifest.json is committed with the sha+URL)
/dist/

# Env files (wallet secrets etc. — see .env.example)
# Root-only: web/.env is committed (VITE_ASSETS_BASE default for dev builds).
/.env
.env.local
.env.*.local
# Arweave wallet keyfiles — never commit
*wallet*.json
!assets_manifest.example.json

web/public/assets/npcs
web/public/assets/objects
web/public/assets/stages
web/public/assets/player
.claude/
