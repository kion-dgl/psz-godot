# Godot 4+ specific ignores
.godot/
/android/
/build/

# Local dev-only files (never part of the build)
/.mcp.json
/blender/

# Game assets live on Cloudflare R2 (see assets_manifest.json for the pack
# URL and scripts/tools/fetch_assets_dev.sh to populate locally). Kenney CC0
# packs are vendored in-tree as exceptions so contributors don't need to
# fetch them — see README credits.
/assets/*
!/assets/kenney_input-prompts/
!/assets/kenney_nature-pack/
# CC0 textures (ambientCG) — vendored in-repo like the kenney packs; ship with
# the main binary, kept out of the SEGA-asset pack + R2 (#356 office library).
!/assets/cc0_textures/
# JetBrains Mono (SIL OFL 1.1) — freely redistributable, so it's vendored in
# source and ships in the binary like the kenney/cc0 packs (NOT pck-gated; the
# pack split is licensing, not size). It was previously swept into the pck by
# the broad /assets/* ignore, which made the start-menu font preload an
# autoload-boot dependency on the pack and blacked out the menu in release
# exports (#448 → #450). Committing it here removes that dependency.
!/assets/fonts/
# Small UI sprites (menu panels, icons) committed directly — too small to be
# worth the R2 round-trip and painful to iterate on through the asset pack.
!/assets/ui/
# Shop preview sprites moved under assets/ui/shop-previews/ so they ship
# with the binary instead of the asset pack — see the .gd helper at
# scripts/2d/components/shop_preview_sprite.gd. The /assets/ui/ rule above
# already un-ignores them recursively; no extra whitelist needed here.
# Original assets we author in-house (e.g. Blender-built room geometry) are
# committed directly so contributors don't need the pack to load these scenes.
# Each parent dir must be re-included before the leaf negation works.
!/assets/stages/
/assets/stages/*
!/assets/stages/city_e/
/assets/stages/city_e/*
!/assets/stages/city_e/s00e_office/
/assets/stages/city_e/s00e_office/*
!/assets/stages/city_e/s00e_office/lndmd/
# Floor meshes are authored in-house (Blender export) for collision tweaks.
# Whitelist *-floor.glb under every stage so they can ship with the binary
# instead of going through the Arweave asset-pack roundtrip. The .glb.import
# companion ships alongside so Godot doesn't re-import on first launch. The
# texture/etc. content inside lndmd stays excluded — only floor meshes.
!/assets/stages/*/
!/assets/stages/*/*/
!/assets/stages/*/*/lndmd/
/assets/stages/*/*/lndmd/*
!/assets/stages/*/*/lndmd/*-floor.glb
!/assets/stages/*/*/lndmd/*-floor.glb.import
# de_roll_le holds PSO-derived decorator meshes (the underground/sewer cave
# pieces), same licensing footing as lndmd content + the SEGA weapon catalog:
# pack + R2 only, never committed to the public repo. The !/assets/stages/*/*/
# negation above would otherwise sweep them into git.
/assets/stages/*/*/de_roll_le/*
# Market dir is mostly pack-only PSO textures, but our authored assets are in-house.
!/assets/stages/city_e/market/
/assets/stages/city_e/market/*
!/assets/stages/city_e/market/canyon_panorama*
!/assets/stages/city_e/market/wall_extension*
# Edited copy of s00e_sa1_m.glb with the original PSO shop carts removed
# (generated by /market-editor, hide-and-export workflow).
!/assets/stages/city_e/market/s00e_sa1_m_no_cart*
# In-house re-export of the market with embedded textures — current
# geometry instanced by city_market.tscn (replaces s00e_sa1_m_no_cart).
!/assets/stages/city_e/market/dairon2*
# In-house replacements for the pack-shipped shop carts.
!/assets/stages/city_e/market/weapon_shop/
!/assets/stages/city_e/market/weapon_shop/*
!/assets/stages/city_e/market/item_shop/
!/assets/stages/city_e/market/item_shop/*
# In-house NPCs converted from third-party assets (VRMs, etc.) live alongside
# the pack-shipped np_*** characters; whitelist them per-folder.
!/assets/npcs/
/assets/npcs/*
!/assets/npcs/item_shop/
!/assets/npcs/item_shop/*
# Reverse-retargeted VRMA animations targeting the PSZ player/NPC
# skeleton. Output of web/scripts/bake-vrma-to-psz.mjs. Lives outside
# assets/player/* (which is asset-pack-only and gets stripped from
# the APK) so it ships in-tree with the binary.
!/assets/animations/
!/assets/animations/*
# Weapon catalog (assets/weapons/* — w*/, basic/, saber/, Slicer*) is all
# SEGA/PSO-derived, so it stays OUT of source (ignored by the /assets/* rule
# above) per the asset-distribution licensing split: it ships via the Arweave
# .pck (game) and the R2 mirror (the web storybook fetches it at runtime via
# VITE_ASSETS_BASE; a fresh clone restores it with
# scripts/tools/fetch_assets_dev.sh). w*/ used to be committed so the
# storybook worked on a fresh clone — that's served from R2 now.
# See spec/src/pages/asset-distribution.astro + issues #284/#245.
# Playwright-mcp scratch directory — populated by browser_take_screenshot
# and browser_snapshot calls during debug sessions. Not project content.
.playwright-mcp/
# Aborted browser-download fragments (occasionally land at the project
# root from xdg-portal flows). Always safe to ignore + delete.
.xdp-Unconfirmed*
# Raw PSOBB SFX pool used by the web labeler; also on R2.
/web/public/assets/psobb_sfx/
# Scratch drop zone — repo-root staging for reference assets (PSO source PNGs,
# mockups, etc.) that are intended to be MOVED into the proper subtree under
# assets/ or web/, not used in-place from the root. Gitignored so the LLM
# doesn't reach in and reference these paths directly; if you see a file you
# need here, relocate it first.
/ref/

# Web app
web/node_modules/
web/dist/
# incremental tsc build cache — machine-local
web/tsconfig.tsbuildinfo
# Dev-only symlinks to psz-sketch (absolute, not portable)
web/public/weapons
web/public/player
web/public/enemies

# Python cache
__pycache__/

# Root-level scratch/dev files (not part of project)
/Gemini_Generated_Image_*
/Humar_body*
/Saber.glb
/Saber_*.png
/Saber_*.png.import
/Saber.glb.import
/Moonlight-*.AppImage
/Phantasy Star Onine_*
/discord_kit_*.txt

# Asset pack build output (assets_manifest.json is committed with the sha+URL)
/dist/

# Env files (wallet secrets etc. — see .env.example)
# Root-only: web/.env is committed (VITE_ASSETS_BASE default for dev builds).
/.env
.env.local
.env.*.local
# Arweave wallet keyfiles — never commit
*wallet*.json
!assets_manifest.example.json

web/public/assets/npcs
web/public/assets/objects
web/public/assets/stages
web/public/assets/player
.claude/*
# Track the project hook config so the merge gate travels with the repo.
!.claude/settings.json

# Local-only marker written by `npm run sanity-check` on success (HEAD sha).
.sanity-pass

# Autopilot screen recordings — generated locally by record_run.sh, listed in
# the /autopilot gallery. Never committed (large binaries).
/spec/public/recordings/

# Local-only quarantine for orphan / superseded files. Moved here instead of
# `rm`-ing so they can be inspected before permanent deletion. Never tracked.
/archive/

# bun deps for the quest solver
scripts/tools/quest_solver/node_modules/

# macOS
.DS_Store
