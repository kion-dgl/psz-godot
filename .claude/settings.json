{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/tools/autoplay/merge_gate.sh\"",
            "statusMessage": "checking sanity-check gate before merge"
          }
        ]
      }
    ]
  }
}
