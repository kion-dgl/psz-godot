; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PSZ Godot"
config/version="0.36.1"
run/main_scene="res://scenes/2d/bootstrap.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://splash_screen.png"
config/icon="res://icon.svg"

[debug]

; GDScript warnings-as-errors (#291 + strict pass). The dead-code / likely-bug /
; shadowing / unused-param set is enforced as errors (level 2) — these fail CI
; via the script-parse gate. untyped_declaration is deliberately NOT enforced
; (hundreds of low-value annotations, esp. for-loop iterators).
gdscript/warnings/enable=true
gdscript/warnings/exclude_addons=true
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/unreachable_pattern=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/redundant_await=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/unused_parameter=2
gdscript/warnings/unused_signal=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
; unused_private_class_variable is WARN, not error: Godot analyzes it per-class,
; so it false-positives on this codebase's extracted-controller pattern, where
; sibling modules (weather_controller, start_menu_input, cell_object_spawner…)
; mutate a back-referenced controller's "private" vars via `_c._foo`. Enforcing
; it as an error would force deleting live state. Kept visible at warn level.
gdscript/warnings/unused_private_class_variable=1

[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
ItemRegistry="*res://scripts/autoloads/item_registry.gd"
WeaponRegistry="*res://scripts/autoloads/weapon_registry.gd"
ArmorRegistry="*res://scripts/autoloads/armor_registry.gd"
EnemyRegistry="*res://scripts/autoloads/enemy_registry.gd"
Inventory="*res://scripts/autoloads/inventory.gd"
SceneManager="*res://scripts/autoloads/scene_manager.gd"
ClassRegistry="*res://scripts/autoloads/class_registry.gd"
CharacterManager="*res://scripts/autoloads/character_manager.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"
ConsumableRegistry="*res://scripts/autoloads/consumable_registry.gd"
ShopRegistry="*res://scripts/autoloads/shop_registry.gd"
ShopManager="*res://scripts/autoloads/shop_manager.gd"
UnitRegistry="*res://scripts/autoloads/unit_registry.gd"
PhotonArtRegistry="*res://scripts/autoloads/photon_art_registry.gd"
DropRegistry="*res://scripts/autoloads/drop_registry.gd"
EnemySpawner="*res://scripts/autoloads/enemy_spawner.gd"
CombatManager="*res://scripts/autoloads/combat_manager.gd"
SessionManager="*res://scripts/autoloads/session_manager.gd"
MagManager="*res://scripts/autoloads/mag_manager.gd"
TechniqueManager="*res://scripts/autoloads/technique_manager.gd"
MaterialRegistry="*res://scripts/autoloads/material_registry.gd"
ModifierRegistry="*res://scripts/autoloads/modifier_registry.gd"
SetBonusRegistry="*res://scripts/autoloads/set_bonus_registry.gd"
CityState="*res://scripts/autoloads/city_state.gd"
PlayerConfig="*res://scripts/autoloads/player_config.gd"
TimeManager="*res://scripts/autoloads/time_manager.gd"
QuestLoader="*res://scripts/autoloads/quest_loader.gd"
ActionPalette="*res://scripts/autoloads/action_palette.gd"
InputConfig="*res://scripts/autoloads/input_config.gd"
RecipeRegistry="*res://scripts/autoloads/recipe_registry.gd"
FrameProfiler="*res://scripts/autoloads/frame_profiler.gd"
MusicManager="*res://scripts/autoloads/music_manager.gd"
SfxManager="*res://scripts/autoloads/sfx_manager.gd"
PsoStartMenu="*res://scripts/3d/field/pso_start_menu.gd"
MobileControls="*res://scripts/autoloads/mobile_controls.gd"
TelepipeManager="*res://scripts/autoloads/telepipe_manager.gd"
BuildInfo="*res://scripts/autoloads/build_info.gd"
Autopilot="*res://scripts/autoloads/autopilot.gd"
JourneyLog="*res://scripts/autoloads/journey_log.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

