# Default asset CDN base URL. Applies to both `npm run dev` and `npm run build`.
# Consumed by web/src/utils/assets.ts — any /assets/* or /psobb_sfx/* path
# gets rewritten to this base at runtime.
#
# Override locally with web/.env.local (gitignored) if you want to point at
# a staging bucket or a local server during asset work.
