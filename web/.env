# Default asset CDN base URL. Applies to both `npm run dev` and `npm run build`.
# Consumed by web/src/utils/assets.ts — /assets/* and /weapons/* paths
# get rewritten to this base when Vite injects VITE_ASSETS_BASE at
# build/dev-serve time.
#
# Override locally with web/.env.local (gitignored) if you want to point at
# a staging bucket or a local server during asset work.
VITE_ASSETS_BASE=https://pub-8bb0622759a042aa9dbd9cb4bd1f21e6.r2.dev
