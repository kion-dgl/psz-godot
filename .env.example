# Copy to .env (which is gitignored) and fill in your values.
# .env is read by scripts/publish/*.ts for uploading asset packs to ArDrive/Arweave.

# ── Arweave wallet (choose ONE — path preferred so the keyfile lives outside the repo) ──

# Option 1: absolute path to a wallet JSON keyfile on disk
ARDRIVE_WALLET_PATH=

# Option 2: seed phrase (12 words, whitespace-separated). Less safe — consider env vs file.
# ARDRIVE_SEED_PHRASE=

# Option 3: the wallet JSON content base64-encoded (single line, no newlines)
# ARDRIVE_WALLET_JSON_B64=

# ── ArDrive target ──

# Drive UUID that holds the asset packs (from ArDrive web UI or CLI)
ARDRIVE_DRIVE_ID=

# Folder UUID inside the drive where packs are uploaded
ARDRIVE_FOLDER_ID=

# ── Cloudflare R2 (secondary mirror) ──

# CF account-scoped API token for bucket/admin operations (not object upload).
# Token needs: Account | Workers R2 Storage | Edit + Account Settings | Read
# Create in dashboard → My Profile → API Tokens → Custom Token.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=psz-godot-assets
# Public base URL — enable the bucket's public dev URL or point to a custom
# domain. Shape: https://pub-<hash>.r2.dev
CLOUDFLARE_R2_PUBLIC_URL=

# R2 S3-compatible credentials — required for object uploads (multipart).
# Create in dashboard → R2 → Manage R2 API Tokens → Object Read & Write.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Typically https://<account_id>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=

# ── Web build ──
# Public CDN base URL for web-built assets. Consumed by web/src/utils/assets.ts
# — when unset, the web editor falls back to local /assets/ (populated via
# scripts/tools/fetch_assets_dev.sh). CI sets this at build time.
VITE_ASSETS_BASE=

# ── DO pack host (dev) — used by `npm run upload-pack-do` ──
# Self-hosted pack server (pck.psz.onl) for fast dev iteration without Arweave.
# Defaults below target the current droplet; override if it moves. No secrets —
# upload is over SSH (your existing key), so nothing extra to configure.
# DO_PACK_SSH=root@159.223.133.93
# DO_PACK_DIR=/srv/packs
# DO_PACK_BASE=https://pck.psz.onl
# DO_PACK_KEEP=15

# ── Optional ──

# Override the Turbo upload service (defaults to public https://upload.ardrive.io)
# TURBO_UPLOAD_URL=
