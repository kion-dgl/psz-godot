      display: flex; flex-direction: row; gap: 1.4cqh;
      font-size: 2.5cqh; line-height: 1.25; color: #1a1a2a;
    }
    /* Left column: title, tabs, list, hint — all aligned to the list width.
       Right column (detail + portrait) runs the full height alongside it. */
    .shop-wf .wf-main { flex: 3; min-width: 0; display: flex; flex-direction: column; gap: 1.2cqh; }
