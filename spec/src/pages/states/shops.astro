          <div class="wf-tabs">
            <span class="wf-tab wf-on">Tab</span><span class="wf-tab">Tab</span><span class="wf-tab">Tab</span><span class="wf-tab">Tab</span>
            <span class="wf-bal">BALANCE</span>
            <em>TAB BAR (mode bar)</em>
          </div>
          <div class="wf-list">
            <strong>LIST</strong>
            <span class="wf-row wf-on">selected row ▸</span>
            <span class="wf-row">row</span>
            <span class="wf-row wf-off">disabled row · can't afford</span>
            <span class="wf-row">row</span>
            <span class="wf-row wf-off">[E] equipped · can't sell</span>
            <span class="wf-row">row</span>
            <em>scrolls · selection stays in view</em>
          </div>
          <div class="wf-hint">HINT — Left/Right · Up/Down · Accept · Cancel</div>
        </div>
        <div class="wf-side">
          <div class="wf-detail"><strong>DETAIL&nbsp;PANEL</strong><span>stats (gear) / effect + count (item) for the selected row — the white scan-lined card</span></div>
          <div class="wf-portrait"><strong>PORTRAIT</strong><span>shopkeeper, overlaid on the right</span></div>
