      background-image: repeating-linear-gradient(0deg,transparent,transparent 0.3cqh,rgba(120,160,200,0.14) 0.3cqh,rgba(120,160,200,0.14) 0.6cqh);
      border: 1px solid rgba(150,180,210,0.5); border-top: 0.45cqh solid #2a3448; border-radius: 0.9cqh; padding: 1.4cqh;
    }
    .shop-wf .wf-portrait {
      flex: 2; background: #8ab8d8; border: 1px dashed #2a3448; border-radius: 0.9cqh; padding: 1.4cqh;
      display: flex; flex-direction: column; justify-content: flex-end;
    }
    .shop-wf strong { display: block; font-size: 0.95em; letter-spacing: 0.05em; margin-bottom: 0.7cqh; }
    .shop-wf .wf-detail span, .shop-wf .wf-portrait span { color: #3a4a5a; font-size: 0.8em; }
