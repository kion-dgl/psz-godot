    .shop-wf .wf-tabs em { order: -1; margin-right: 0.4cqh; }
    .shop-wf .wf-list {
      flex: 1; min-height: 0; background: rgba(255,255,255,0.5); border: 1px dashed #7aa0c0; border-radius: 0.8cqh;
