---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Mermaid from '../components/Mermaid.astro';

const journeyChart = `flowchart TD
  Splash[Splash Screen] --> Download[Download Content]
  Download -->|first run| Controls[Controls Setup]
  Download -->|subsequent| Title[Title Screen]
  Controls --> Title
  Title --> CharSelect[Character Select]
  CharSelect -->|existing slot| Market[Market]
  CharSelect -->|empty slot| Create[Create Character]
  Create --> Customize[Customize Character]
  Customize -->|intro spawn| Office[Principal's Office]

  click Splash "/journey/splash"
  click Download "/journey/download"
  click Controls "/journey/controls"
  click Title "/journey/title"
  click CharSelect "/journey/character-select"
  click Create "/journey/create-character"
  click Customize "/journey/character-customize"
  click Office "/journey/city/office"
  click Market "/journey/city/market"

  classDef screen fill:#161b22,stroke:#58a6ff,color:#e6edf3,stroke-width:2px
  class Splash,Download,Controls,Title,CharSelect,Create,Customize,Office,Market screen
`;

const cityChart = `flowchart LR
  Office[Principal's Office] <--> Counter[Guild Counter]
  Counter <--> Market[Market]
  Counter <--> Teleport[Teleport]
  Market <--> Underground[Underground]
  Teleport -.->|warp pad| Field([Field])

  click Office "/journey/city/office"
  click Counter "/journey/city/counter"
  click Market "/journey/city/market"
  click Teleport "/journey/city/teleport"
  click Underground "/journey/city/underground"

  classDef area fill:#161b22,stroke:#f0a020,color:#e6edf3,stroke-width:2px
  classDef external fill:#0d1117,stroke:#8b949e,color:#8b949e,stroke-dasharray:5 5
  class Office,Counter,Market,Teleport,Underground area
  class Field external
`;

const shopsChart = `flowchart TB
  subgraph MarketArea[Market]
    direction LR
    WeaponShop[Weapon Shop]
    ItemShop[Item Shop]
    TechShop[Tech Shop]
    Tekker[Tekker]
  end

  subgraph CounterArea[Guild Counter]
    direction LR
    QuestCounter[Quest Counter]
    Storage[Storage]
  end

  subgraph UndergroundArea[Underground]
    direction LR
    CraftingShop[Synthesis Shop]
    PhotonShop[Photon Collector]
  end

  click WeaponShop "/shop/weapon-shop"
  click ItemShop "/shop/item-shop"
  click TechShop "/shop/tech-shop"
  click Tekker "/shop/tekker"
  click QuestCounter "/shop/quest-counter"
  click Storage "/shop/storage"
  click CraftingShop "/shop/crafting-shop"
  click PhotonShop "/shop/photon-shop"

  classDef shop fill:#161b22,stroke:#f8c840,color:#e6edf3,stroke-width:2px
  class WeaponShop,ItemShop,TechShop,Tekker,QuestCounter,Storage,CraftingShop,PhotonShop shop
`;
---

<Base title="Overview">
  <div class="shell">
    <Navbar current="Overview" />
    <main>
      <h1>PSZ Spec</h1>
      <p>Screen definitions, game mechanics, and state documentation for Phantasy Star Zero Godot.</p>

      <h2>User Journey</h2>
      <Mermaid chart={journeyChart} />

      <h2>City</h2>
      <Mermaid chart={cityChart} />

      <h2>Shops</h2>
      <Mermaid chart={shopsChart} />
    </main>
  </div>
</Base>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }
  main {
    flex: 1;
    overflow-y: auto;
    padding: 40px;
    max-width: 960px;
    margin: 0 auto;
  }
  h1 { font-size: 24px; margin-bottom: 8px; }
  main > p { color: #8b949e; margin-bottom: 32px; }
  h2 {
    font-size: 16px;
    margin-bottom: 12px;
    margin-top: 32px;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
