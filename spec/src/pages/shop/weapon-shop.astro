---
import Definition from '../../layouts/Definition.astro';
import WeaponShop from '../../components/screens/shops/WeaponShop';
---

<Definition title="Weapon Shop" section="States">
  <WeaponShop slot="preview" client:only="react" />

  <h2>Purpose</h2>
  <p>Buy and sell weapons, armor, and units. Tabs switch between equipment categories.</p>

  <h2>Behavior</h2>
  <p>Player selects a category tab to browse available stock. Purchasing deducts meseta and adds the item to inventory. Selling returns a fraction of the item's value.</p>

  <h2>Location</h2>
  <p>Market area, accessed by interacting with the Weapon Shop NPC.</p>
</Definition>
