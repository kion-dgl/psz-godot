---
import Definition from '../../layouts/Definition.astro';
import WeaponShop from '../../components/screens/shops/WeaponShop';
---

<Definition title="Weapon Shop" section="States">
  <WeaponShop slot="preview" client:only="react" />

  <h2>Purpose</h2>
  <p>Buy and sell equipment with meseta (M). Four tabs: Weapons, Armor, Units, Sell.</p>

  <h2>Behavior</h2>
  <p>The detail panel shows the selected weapon's type, rarity, ATK/ACC range, element, and max grind, plus buy/sell prices. Selling returns half the buy price.</p>

  <h2>Location</h2>
  <p>Market area, accessed by interacting with the Weapon Shop NPC.</p>
</Definition>
