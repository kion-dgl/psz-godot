---
import Definition from '../../layouts/Definition.astro';
import CraftingShop from '../../components/screens/shops/CraftingShop';
---

<Definition title="Crafting Shop" section="States">
  <CraftingShop slot="preview" client:only="react" />

  <h2>Purpose</h2>
  <p>Craft weapons from materials and grinders, and apply photon crystals for elemental special attacks.</p>

  <h2>Behavior</h2>
  <p>Crafting consumes materials and grinders to produce a weapon. Photon crystals can be applied to add an elemental special attack. The crafted weapon's tier is rolled based on weapon rarity.</p>

  <h2>Location</h2>
  <p>Underground area, accessed by interacting with the Synthesis NPC.</p>
</Definition>
