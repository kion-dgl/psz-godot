---
import Definition from '../../layouts/Definition.astro';
import PhotonShop from '../../components/screens/shops/PhotonShop';
---

<Definition title="Photon Shop" section="States">
  <PhotonShop slot="preview" client:only="react" />

  <h2>Purpose</h2>
  <p>Trade Photon Drops for grinders, photon crystals, and crafting materials.</p>

  <h2>Behavior</h2>
  <p>The Photon Collector NPC exchanges Photon Drops (a field-drop currency) for consumable crafting supplies. No meseta is involved in these trades.</p>

  <h2>Location</h2>
  <p>Underground area, accessed by interacting with the Photon Collector NPC.</p>
</Definition>
