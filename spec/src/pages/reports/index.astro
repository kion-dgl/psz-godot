---
// Public bug-report triage list. Reads REPORTS_DIR at request time (the same
// dir /api/report writes to). No auth — reports carry no IPs or private data.
export const prerender = false;
import PlaytestBase from '../../layouts/PlaytestBase.astro';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';

const REPORTS_DIR = process.env.REPORTS_DIR ?? './reports';

interface Row { id: string; received_at?: string; source?: string; reporter_handle?: string; free_text?: string; version?: string; status?: string; issue?: number }
// Triage status: absent ⇒ still open. resolved = fixed, wontfix = closed as won't-do.
const STATUS_LABEL: Record<string, string> = { open: 'open', resolved: 'resolved', wontfix: "won't do" };
let reports: Row[] = [];
try {
  const dirs = (await readdir(REPORTS_DIR, { withFileTypes: true }))
    .filter((d) => d.isDirectory()).map((d) => d.name);
  reports = (await Promise.all(dirs.map(async (id): Promise<Row> => {
    try { return { id, ...JSON.parse(await readFile(join(REPORTS_DIR, id, 'report.json'), 'utf8')) }; }
    catch { return { id }; }
  }))).sort((a, b) => (b.received_at ?? b.id).localeCompare(a.received_at ?? a.id));
} catch { /* dir not created yet */ }
---

<PlaytestBase title="Reports — Phantasy Star Zero">
  <main>
    <h1>Bug reports <span class="count">{reports.length}</span></h1>
    {reports.length === 0 && <p class="tag">No reports yet.</p>}
    <ul class="list">
      {reports.map((r) => (
        <li data-status={r.status ?? 'open'}>
          <a href={`/reports/${r.id}`}>
            <time>{r.received_at?.replace('T', ' ').replace(/\..*/, '') ?? r.id}</time>
            <span class="src">{r.source ?? '—'}</span>
            <span class="who">{r.reporter_handle ?? 'anon'}</span>
            <span class="txt">{(r.free_text ?? '').slice(0, 90) || '(no text)'}</span>
            <span class="meta">
              {r.issue != null && <span class="issue">#{r.issue}</span>}
              <span class={`badge st-${r.status ?? 'open'}`}>{STATUS_LABEL[r.status ?? 'open'] ?? r.status}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style>
    main { max-width: 860px; margin: 0 auto; padding: 2rem 1.25rem 4rem; width: 100%; }
    h1 { font-size: 1.5rem; }
    .count { color: #8b93a7; font-weight: 400; }
    .tag { color: #8b93a7; }
    ul.list { list-style: none; padding: 0; margin: 1rem 0 0; }
    ul.list li { border-bottom: 1px solid #1d2433; }
    ul.list a {
      display: grid; grid-template-columns: 160px 90px 120px 1fr auto; gap: 0.75rem;
      padding: 0.7rem 0.25rem; text-decoration: none; color: #e6e9ef; align-items: baseline;
    }
    ul.list a:hover { background: #11161f; }
    /* Triaged-closed rows recede so the open queue stands out. */
    ul.list li[data-status="resolved"] a,
    ul.list li[data-status="wontfix"] a { opacity: 0.5; }
    time { color: #8b93a7; font-size: 0.85rem; font-variant-numeric: tabular-nums; }
    .src { color: #7aa2ff; font-size: 0.82rem; }
    .who { color: #b6bdcc; font-size: 0.85rem; }
    .txt { color: #c9d1d9; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .meta { display: inline-flex; gap: 0.5rem; align-items: baseline; justify-self: end; }
    .issue { color: #7aa2ff; font-size: 0.78rem; font-variant-numeric: tabular-nums; }
    .badge {
      font-size: 0.72rem; padding: 0.05rem 0.45rem; border-radius: 999px;
      border: 1px solid currentColor; white-space: nowrap; text-transform: lowercase;
    }
    .st-open { color: #d4a843; }
    .st-resolved { color: #4ade80; }
    .st-wontfix { color: #8b93a7; }
    @media (max-width: 600px) {
      ul.list a { grid-template-columns: 1fr auto; gap: 0.15rem 0.5rem; }
      .meta { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
    }
  </style>
</PlaytestBase>
