---
// Landing for the per-stage viewer — lists every (area, variant) pair
// that has stages, grouped by area.

import Base from '../../../layouts/Base.astro';
import { AREA_META, areaNumToSlug } from '../../../components/stage-spec/areas';
import stageConfigs from '../../../../../data/stage_configs/unified-stage-configs.json';

const buckets: Record<string, Record<string, number>> = {};
for (const id of Object.keys(stageConfigs)) {
  const m = id.match(/^s(\d{2})([a-z])_/);
  if (!m) continue;
  const area = areaNumToSlug(m[1]);
  if (!area) continue;
  (buckets[area] ??= {});
  buckets[area][m[2]] = (buckets[area][m[2]] ?? 0) + 1;
}
// Order by AREA_META insertion (area-number ascending).
const orderedAreas = Object.keys(AREA_META).filter((a) => buckets[a]);
---

<Base title="Field Stages">
  <div class="page">
    <header>
      <a href="/" class="back">← spec</a>
      <h1>Field Stages</h1>
    </header>
    <div class="content">
      <p class="lede">
        Per-stage viewer with floor mesh, visual mesh (<code>_m.glb</code>), Manhattan grid
        overlay, and live waypoints from <code>unified-stage-configs.json</code>. Pick an
        area + variant.
      </p>
      <ul class="area-list">
        {orderedAreas.map((area) => {
          const meta = AREA_META[area];
          const variants = Object.entries(buckets[area]).sort();
          return (
            <li class="area-row">
              <span class="area-name">{meta.display}</span>
              <span class="area-slug">{area}</span>
              <div class="variants">
                {variants.map(([v, n]) => (
                  <a class="variant-link" href={`/journey/field/${area}/${v}`}>
                    <span class="variant-letter">{v.toUpperCase()}</span>
                    <span class="variant-count">{n}</span>
                  </a>
                ))}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <style>
    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 8px 16px;
      background: #161b22;
      border-bottom: 1px solid #30363d;
    }
    header h1 {
      font-size: 18px;
      font-weight: 600;
    }
    .back { color: #8b949e; font-size: 13px; }
    .content {
      max-width: 900px;
      margin: 0 auto;
      padding: 24px;
      width: 100%;
    }
    .lede {
      color: #c9d1d9;
      margin-bottom: 24px;
      font-size: 14px;
    }
    code {
      font-family: ui-monospace, monospace;
      background: #161b22;
      padding: 1px 5px;
      border-radius: 3px;
      font-size: 12px;
    }
    .area-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .area-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: #161b22;
      border-radius: 6px;
    }
    .area-name {
      font-size: 15px;
      font-weight: 500;
      min-width: 200px;
    }
    .area-slug {
      font-family: ui-monospace, monospace;
      font-size: 12px;
      color: #6b7280;
      min-width: 90px;
    }
    .variants {
      display: flex;
      gap: 6px;
      margin-left: auto;
    }
    .variant-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      background: #21262d;
      color: #c9d1d9;
      border-radius: 4px;
      text-decoration: none;
      font-size: 13px;
    }
    .variant-link:hover {
      background: #1f6feb;
      color: white;
      text-decoration: none;
    }
    .variant-letter {
      font-family: ui-monospace, monospace;
      font-weight: 600;
    }
    .variant-count {
      font-size: 11px;
      color: #8b949e;
    }
    .variant-link:hover .variant-count { color: #cbd5e1; }
  </style>
</Base>
