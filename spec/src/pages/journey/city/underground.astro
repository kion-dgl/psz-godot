---
import { siteUrl } from '../../../utils/site';
import Definition from '../../../layouts/Definition.astro';
import StagePreview from '../../../components/screens/StagePreview';
---

<Definition title="Underground" section="Journey">
  <StagePreview
    client:only="react"
    slot="preview"
    glb="assets/stages/city_e/s00e_sa4/lndmd/s00e_sa4_m.glb"
    spawn={[0.04, 0, -1]}
    cameraOffset={[0, 8, 12]}
  />

  <h2>Context</h2>
  <p>Sewer area beneath the market. Optional services and the blackjack minigame.</p>

  <h2>NPCs</h2>
  <ul>
    <li><strong>Synthesis Shop</strong> — crafting</li>
    <li><strong>Photon Collector</strong> — trade photon drops</li>
    <li><strong>Blackjack Dealer</strong> — saloon blackjack (Booth cowgirl model)</li>
  </ul>

  <h2>Exits</h2>
  <ul>
    <li>Stairs up → <a href={siteUrl('/journey/city/market')}>Market</a></li>
  </ul>

  <h2>Boundaries</h2>
  <p>Walkable octagons, central bridge, and canal/alcove collision walls are authored in <code>data/stage_configs/city-boundaries/underground.json</code> (<a href={siteUrl('/states/city-boundaries')}>City Walkable Boundaries</a>).</p>
</Definition>
