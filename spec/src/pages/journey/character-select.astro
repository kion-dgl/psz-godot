---
import Definition from '../../layouts/Definition.astro';
import Mermaid from '../../components/Mermaid.astro';
import CharSelectScreen from '../../components/screens/CharSelectScreen';
---

<Definition title="Character Select" section="Journey">
  <CharSelectScreen slot="preview" client:only="react" />

  <h2>Purpose</h2>
  <p>Choose an existing character to play or select an empty slot to create a new one. PSO PC V2 list-style layout with 3D model preview.</p>

  <h2>Layout</h2>
  <p>Gold banner across the top. Character list on the left (scrollable, 20 slots). 3D model preview on the right with class description below. Start/Create button bottom-right.</p>

  <h2>Slots</h2>
  <p>20-slot floor. Filled slots show name, class, level, and playtime. Empty slots show "(Empty Slot)" — selecting one routes to <a href="/journey/create-character">Create Character</a>.</p>

  <Mermaid chart={`flowchart TD
    A[Character Select] -->|Filled slot + Confirm| B[City]
    A -->|Empty slot + Confirm| C[Create Character]
    A -->|Cancel| D[Title Screen]
  `} />

  <h2>3D Preview</h2>
  <p>Loads the selected class's GLB model with pixel-filtered texture from R2. Camera at y=1.1 z=3.4 looking at torso height. Empty slots show a placeholder message.</p>

  <h2>Previous</h2>
  <p><a href="/journey/title">← Title Screen</a></p>
  <h2>Next</h2>
  <p><a href="/journey/create-character">Create Character →</a> or <a href="/journey/city">City →</a></p>
</Definition>
