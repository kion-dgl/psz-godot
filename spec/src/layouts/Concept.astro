---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Base title={title}>
  <div class="shell">
    <Navbar current="States" />
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </div>
</Base>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }
  main {
    flex: 1;
    overflow-y: auto;
    padding: 36px 40px 80px;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }
  /* Prose stays at a readable column width; the diagram spans the full main. */
  main :global(h2),
  main :global(p),
  main :global(ul),
  main :global(table) {
    max-width: 820px;
  }
  h1 {
    font-size: 24px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid #30363d;
  }
  main :global(h2) {
    font-size: 13px;
    margin-top: 28px;
    margin-bottom: 10px;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  main :global(p) {
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 12px;
    color: #c9d1d9;
  }
  main :global(ul) {
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 12px;
    padding-left: 20px;
    color: #c9d1d9;
  }
  main :global(li) { margin-bottom: 4px; }
  main :global(code) {
    font-size: 12.5px;
    background: #161b22;
    padding: 2px 6px;
    border-radius: 3px;
    color: #e6edf3;
    font-family: ui-monospace, monospace;
  }
  main :global(table) {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    margin: 8px 0 16px;
  }
  main :global(th),
  main :global(td) {
    padding: 7px 10px;
    border: 1px solid #30363d;
    text-align: left;
    vertical-align: top;
  }
  main :global(th) {
    background: #161b22;
    color: #8b949e;
    font-weight: 600;
  }
  main :global(td) { color: #c9d1d9; }
  /* The state diagram sits in a framed hero box at the top of each page */
  main :global(.diagram) {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 8px;
    display: flex;
    justify-content: center;
  }
</style>
