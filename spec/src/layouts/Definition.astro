---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
import { stepForPath } from '../autopilot';

interface Props {
  title: string;
  section?: string;
}
const { title, section } = Astro.props;
const step = stepForPath(Astro.url.pathname);
---

<Base title={title}>
  <div class="shell">
    <Navbar current={section} />
    <div class="content">
      <div class="preview">
        <div class="aspect">
          <slot name="preview" />
        </div>
      </div>
      <aside class="sidebar">
        <h1>{title}</h1>
        {step && (
          <a class={`ap-note ${step.status}`} href="/autopilot">
            <span class="ap-row">
              <span class="ap-badge">Autopilot · Step {step.n}</span>
              <span class="ap-persona">{step.persona}</span>
              <span class="ap-status">{step.status === 'done' ? '✓ covered' : 'planned'}</span>
            </span>
            <span class="ap-text">{step.note}</span>
          </a>
        )}
        <slot />
      </aside>
    </div>
  </div>
</Base>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }
  .content {
    flex: 1;
    display: flex;
    min-height: 0;
  }
  .preview {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #010409;
    min-width: 0;
    overflow: hidden;
  }
  .aspect {
    width: 960px;
    height: 540px;
    flex-shrink: 0;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }
  .sidebar {
    width: 360px;
    flex-shrink: 0;
    overflow-y: auto;
    padding: 20px;
    border-left: 1px solid #30363d;
    background: #0d1117;
  }
  .sidebar h1 {
    font-size: 18px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #30363d;
  }
  .sidebar :global(h2) {
    font-size: 14px;
    margin-top: 20px;
    margin-bottom: 8px;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .sidebar :global(p) {
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 12px;
    color: #c9d1d9;
  }
  .sidebar :global(ul) {
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 12px;
    padding-left: 18px;
    color: #c9d1d9;
  }
  .sidebar :global(code) {
    font-size: 12px;
    background: #161b22;
    padding: 2px 5px;
    border-radius: 3px;
    color: #e6edf3;
  }
  .sidebar :global(table) {
    width: 100%;
    font-size: 12px;
    border-collapse: collapse;
    margin-bottom: 12px;
  }
  .sidebar :global(th),
  .sidebar :global(td) {
    padding: 6px 8px;
    border: 1px solid #30363d;
    text-align: left;
  }
  .sidebar :global(th) {
    background: #161b22;
    color: #8b949e;
    font-weight: 600;
  }
  /* Per-page autopilot coverage note (driven by src/autopilot.ts). */
  .ap-note {
    display: block;
    margin: 0 0 16px;
    padding: 10px 12px;
    border: 1px solid #30363d;
    border-left: 3px solid #8b949e;
    border-radius: 4px;
    background: #161b22;
  }
  .ap-note:hover { text-decoration: none; border-color: #58a6ff; }
  .ap-note.done { border-left-color: #3fb950; }
  .ap-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  .ap-badge {
    font-size: 11px;
    font-weight: 700;
    color: #e6edf3;
    background: #21262d;
    padding: 2px 7px;
    border-radius: 10px;
  }
  .ap-persona { font-size: 11px; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px; }
  .ap-status { font-size: 11px; margin-left: auto; color: #8b949e; }
  .ap-note.done .ap-status { color: #3fb950; font-weight: 600; }
  .ap-text { font-size: 12px; line-height: 1.5; color: #c9d1d9; display: block; }
</style>
