{
  "name": "psz-godot-site",
  "private": true,
  "description": "Repo-level dev/test entry points for PSZ Godot.",
  "scripts": {
    "sanity-check": "bash scripts/tools/autoplay/sanity_check.sh",
    "shop-smoke": "bash scripts/tools/autoplay/shop_smoke.sh",
    "wp:todo": "node scripts/tools/waypoints/wp_tool.mjs todo",
    "wp:paste": "node scripts/tools/waypoints/wp_tool.mjs paste",
    "wp:apply": "node scripts/tools/waypoints/wp_tool.mjs apply",
    "wp:check": "node scripts/tools/waypoints/wp_tool.mjs check",
    "wp:baseline": "node scripts/tools/waypoints/wp_tool.mjs baseline",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "jszip": "^3.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.1.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.172.0",
    "@astrojs/react": "^5.0.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.172.0",
    "astro": "^6.4.8",
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "typescript": "~5.7.0",
    "vitest": "^4.0.18"
  }
}
