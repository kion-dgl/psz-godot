  "briefing_dialog": [
    {
      "speaker": "Principal",
      "text": "This mission is classified. What you're about to hear does not leave this room."
    },
    {
      "speaker": "Principal",
      "text": "This is Mira, from the Research Division. She's been studying fragments recovered from the Paru ruins."
    },
    {
      "speaker": "Mira",
      "text": "The ruins contain records from before the Great Blank, logs that could explain what happened to this world."
    },
    {
      "speaker": "Mira",
      "text": "Our excavation crew has been pulling intact message logs out of the deeper galleries. I need every one of them recovered before the automata get to them first."
    },
    {
      "speaker": "Mira",
      "text": "I'd go myself, but the ruins are crawling with active automata. I'm sending Elio with you. She knows what to look for."
    },
    {
      "speaker": "Elio",
      "text": "I've studied Mira's notes. I'll know the logs when I see them. You keep us alive."
    },
    {
      "speaker": "Principal",
      "text": "Recover the logs and return safely. The Research Division is counting on this."
    }
  ],
