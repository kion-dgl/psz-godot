  "briefing_dialog": [
    {
      "speaker": "Principal",
      "text": "This is Elio, from the Research Division. She has a request."
    },
    {
      "speaker": "Elio",
      "text": "Sorry. Hi. I'm the guild's Mag custodian. The Mags we give to new hunters come through me first. Yours, too."
    },
    {
      "speaker": "Elio",
      "text": "There's a cache of dormant Mag Cells out in Paru. The kind we use to make a new Mag. We don't have many left."
    },
    {
      "speaker": "Elio",
      "text": "I have to be the one to fetch them. The cells listen for someone who knows how to wake them up."
    },
    {
      "speaker": "Elio",
      "text": "I'm not a fighter. I'm asking you to come with me."
    },
    {
      "speaker": "Principal",
      "text": "The Research Division has authorized the expedition. Bring her back safely."
    }
  ],
