  "briefing_dialog": [
    {
      "speaker": "Principal",
      "text": "This is Elio, from the Research Division. She has a request."
    },
    {
      "speaker": "Elio",
      "text": "I'm the guild's Mag custodian. I look after the Mags we provision to new hunters. Yours came through me, actually."
    },
    {
      "speaker": "Elio",
      "text": "There are dormant Mag Cells deep in Paru, enough to assemble another one."
    },
    {
      "speaker": "Elio",
      "text": "The guild's stock is low. If we recover them, I can raise another for the next hunter who needs a partner."
    },
    {
      "speaker": "Elio",
      "text": "The automata won't make it easy. I need someone who can fight while I work."
    },
    {
      "speaker": "Principal",
      "text": "The Research Division has authorized the expedition. Keep Elio safe and bring back what you find."
    }
  ],
