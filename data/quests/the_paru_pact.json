  "briefing_dialog": [
    {
      "speaker": "Principal",
      "text": "This is Elio, from the Research Division. She has a request."
    },
    {
      "speaker": "Elio",
      "text": "I'm the guild's Mag custodian. Every Mag a hunter carries passes through me first. Yours included."
    },
    {
      "speaker": "Elio",
      "text": "We're running low on parts to build new Mags. There are old fragments scattered through the Paru ruins, enough to piece one together."
    },
    {
      "speaker": "Elio",
      "text": "I need to be the one to recover them. Each fragment has to be handled a certain way or it won't bond with the others."
    },
    {
      "speaker": "Elio",
      "text": "I'm not a fighter. That's where you come in. Get me to each fragment and back."
    },
    {
      "speaker": "Principal",
      "text": "The Research Division has authorized the expedition. Keep her safe."
    }
  ],
