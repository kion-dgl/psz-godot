{
  "version": 1,
  "last_updated": "2026-04-05",
  "id": "the_broken_seal",
  "name": "The Broken Seal",
  "description": "Makara ruins seal puzzle, door to Dark Shrine.",
  "area_id": "makara",
  "office_npcs": [
    {
      "npc_id": "dr_carlo",
      "npc_name": "Dr. Carlo",
      "office_position": "pos_1"
    }
  ],
  "briefing_dialog": [
    {
      "speaker": "Dr. Carlo",
      "text": "Surveyors found something at Makara two days ago. A structure. Ruins, technically, but..."
    },
    {
      "speaker": "Dr. Carlo",
      "text": "Our dating estimates put the construction at least a thousand years before the Great Blank. Possibly more."
    },
    {
      "speaker": "Dr. Carlo",
      "text": "There shouldn't be anything that old still standing. There certainly shouldn't be anything that old still intact."
    },
    {
      "speaker": "Dr. Carlo",
      "text": "Hunters who've approached the perimeter report hearing voices. Not animal calls — words. None of them speak the language."
    },
    {
      "speaker": "Dr. Carlo",
      "text": "The surveyors also identified crystal formations in the deeper galleries. I want to document them. I'll need someone capable to escort me in."
    },
    {
      "speaker": "Principal",
      "text": "Dr. Carlo will be with you. Keep him alive. Let him do his work."
    }
  ],
