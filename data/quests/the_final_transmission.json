              "dialog": [
                {
                  "speaker": "",
                  "text": "A message pack lies on the ground next to a hunter slumped against the wall. His coat is torn. He isn't moving."
                },
                {
                  "speaker": "",
                  "text": "The recording is faint. Barely a whisper."
                },
                {
                  "speaker": "Voss",
                  "text": "...can't feel my hands anymore. It's cold down here. Didn't think it'd be this cold."
                },
                {
                  "speaker": "Voss",
                  "text": "Ren... I'm sorry, kid. I promised I'd come back."
                },
                {
                  "speaker": "Voss",
                  "text": "If only I could see you again."
                },
                {
                  "speaker": "",
                  "text": "The recording cuts out."
                },
