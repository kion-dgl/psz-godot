  ],
  "briefing_dialog": [
    {
      "speaker": "Principal",
      "text": "The data we recovered from the tower included activation codes for a teleporter — one we didn't know existed. It links to a place called Arca."
    },
    {
      "speaker": "Sarisa",
      "text": "I know Arca. I came from there."
    },
    {
      "speaker": "Principal",
      "text": "Sarisa volunteered the moment we said the name."
    },
    {
      "speaker": "Sarisa",
      "text": "If we're going, I'm going with you. There are things on Arca only I'll recognize — and things you'll need me to recognize."
    },
    {
      "speaker": "Sarisa",
      "text": "Don't ask me what to expect. I haven't been home in a long time."
    },
    {
      "speaker": "Principal",
      "text": "Investigate the facility. Report what you find. And listen to her."
    }
  ],
