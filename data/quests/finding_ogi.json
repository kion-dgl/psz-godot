  "id": "finding_ogi",
  "name": "Finding Ogi",
  "description": "A veteran CAST hunter has gone missing in the Rioh Snowfield. Find him and recover his body parts.",
  "area_id": "rioh",
  "office_npcs": [
    {
      "npc_id": "ren",
      "npc_name": "Ren",
      "office_position": "pos_1"
    }
  ],
  "briefing_dialog": [
    {
      "speaker": "Ren",
      "text": "We've lost contact with Ogi. He's a CAST, deployed to the Rioh snowfield three days ago."
    },
    {
      "speaker": "Ren",
      "text": "His patrol channel went dark mid-route. No distress, no last transmission. Just silence."
    },
    {
      "speaker": "Ren",
      "text": "We don't know what happened. Find out. Bring back what you can."
    }
  ],
