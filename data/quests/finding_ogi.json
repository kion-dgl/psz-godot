  "briefing_dialog": [
    {
      "speaker": "Ren",
      "text": "We've lost contact with Ogi. He's a CAST, deployed to the Rioh snowfield three days ago."
    },
    {
      "speaker": "Ren",
      "text": "His patrol channel went dark mid-route. No distress, no last transmission. Just silence."
    },
    {
      "speaker": "Ren",
      "text": "We don't know what happened. Find out. Bring back what you can."
    }
  ]
