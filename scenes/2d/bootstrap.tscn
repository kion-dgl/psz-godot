[sub_resource type="Shader" id="ShaderBG"]
code = "shader_type canvas_item;
void fragment() {
	vec3 top = vec3(0.490, 0.827, 0.988);
	vec3 mid = vec3(0.220, 0.741, 0.973);
	vec3 bot = vec3(0.145, 0.388, 0.922);
	float t = UV.y;
	vec3 col = mix(top, mid, smoothstep(0.0, 0.45, t));
	col = mix(col, bot, smoothstep(0.45, 1.0, t));
	COLOR = vec4(col, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="MatBG"]
shader = SubResource("ShaderBG")

[sub_resource type="Shader" id="ShaderBanner"]
code = "shader_type canvas_item;
void fragment() {
	vec4 cream = vec4(0.996, 0.976, 0.765, 0.55);
	vec4 sky = vec4(0.729, 0.902, 0.992, 0.30);
	vec4 clear = vec4(0.729, 0.902, 0.992, 0.0);
	float t = UV.y;
	vec4 col = mix(cream, sky, smoothstep(0.0, 0.70, t));
	col = mix(col, clear, smoothstep(0.70, 1.0, t));
	COLOR = col;
}
"

[sub_resource type="ShaderMaterial" id="MatBanner"]
shader = SubResource("ShaderBanner")

[sub_resource type="Shader" id="ShaderGoldStripe"]
code = "shader_type canvas_item;
void fragment() {
	vec3 gold = vec3(0.992, 0.878, 0.278);
	vec3 gold_dim = vec3(0.980, 0.776, 0.082);
	float t = UV.x;
	float alpha = 0.0;
	if (t < 0.12) alpha = smoothstep(0.0, 0.12, t) * 0.5;
	else if (t < 0.40) alpha = mix(0.5, 1.0, smoothstep(0.12, 0.40, t));
	else if (t < 0.60) alpha = 1.0;
	else if (t < 0.88) alpha = mix(1.0, 0.5, smoothstep(0.60, 0.88, t));
	else alpha = mix(0.5, 0.0, smoothstep(0.88, 1.0, t));
	vec3 col = mix(gold_dim, gold, smoothstep(0.30, 0.50, t));
	col = mix(col, gold_dim, smoothstep(0.50, 0.70, t));
	COLOR = vec4(col, alpha);
}
"

[sub_resource type="ShaderMaterial" id="MatGoldStripe"]
shader = SubResource("ShaderGoldStripe")

