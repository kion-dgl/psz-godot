extends SceneTree
## Headless check: scripts/utils/field_rng.gd (field-generation LCG) against
## reference vectors. Generated by the big-int Python mirror of the constants
## in data/re_reference/level_generation_algorithm.json; the limb algorithm
## was additionally verified equal to the reference on 200 seeds x 20 draws.
## Run: godot --headless --path . --script res://scripts/tools/field_rng_check.gd

const VECTORS := [
	[0x00005F8C, 0x00000000, [3, 100, 10000, 0, 2, 4294967295, 7], [2, 37, 1274, 1197385037, 1, 1368150407, 2]],
	[0x12345678, 0x9ABCDEF0, [100, 3, 0, 10000, 4], [41, 2, 3572816793, 1958, 0]],
	[0xDEADBEEF, 0xCAFEBABE, [0, 0, 255, 100, 2, 3], [2952351504, 4187993404, 59, 91, 0, 1]],
]


func _init() -> void:
	var fails := 0
	var checks := 0
	for row in VECTORS:
		var rng := FieldRng.new(row[0], row[1])
		var ranges: Array = row[2]
		var expected: Array = row[3]
		for i in ranges.size():
			checks += 1
			var got: int = rng.draw(ranges[i])
			if got != expected[i]:
				fails += 1
				push_error("seed 0x%08X%08X draw(%d) #%d: got %d expected %d" % [row[1], row[0], ranges[i], i, got, expected[i]])
	if fails:
		push_error("field_rng_check: %d/%d checks FAILED" % [fails, checks])
		quit(1)
	else:
		print("field_rng_check: %d checks passed" % checks)
		quit(0)
